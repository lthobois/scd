<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Novalys" targetNamespace="https://novalys.example/formation/bpmn">
  <bpmn:process id="Process_Commande" name="Traiter une commande Novalys" isExecutable="false">
    <bpmn:startEvent id="Start" name="Commande reçue">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Controler" name="Contrôler les droits">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Choix" name="À préciser">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Enregistrer" name="Enregistrer la commande">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Confirmer" name="Commande confirmée">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Controler" />
    <bpmn:sequenceFlow id="F2" sourceRef="Controler" targetRef="Choix" />
    <bpmn:sequenceFlow id="F3" sourceRef="Choix" targetRef="Enregistrer" />
    <bpmn:sequenceFlow id="F4" sourceRef="Enregistrer" targetRef="Confirmer" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Commande">
    <bpmndi:BPMNPlane id="Plane_Commande" bpmnElement="Process_Commande">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="90" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="60" y="248" width="96" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Controler_di" bpmnElement="Controler">
        <dc:Bounds x="175" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Choix_di" bpmnElement="Choix" isMarkerVisible="true">
        <dc:Bounds x="350" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="320" y="255" width="110" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Enregistrer_di" bpmnElement="Enregistrer">
        <dc:Bounds x="465" y="180" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Confirmer_di" bpmnElement="Confirmer">
        <dc:Bounds x="655" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="625" y="248" width="96" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="126" y="220" />
        <di:waypoint x="175" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="295" y="220" />
        <di:waypoint x="350" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="400" y="220" />
        <di:waypoint x="465" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="595" y="220" />
        <di:waypoint x="655" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
